{
  "name": "beepy-card-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Beepy Educational Card Game Engine - a subject-neutral browser card-game framework with two playable demos on one engine: Beepy's Math Cards (second-grade addition) and Beepy's Clinical Cards (physician-reviewed disease facts).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared-engine",
    "math-cards",
    "clinical-cards"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
