# Beepy Educational Card Game Engine - .gitignore
#
# IMPORTANT: The .kiro/ directory and all of its subfolders (specs, steering,
# hooks) are INTENTIONALLY NOT IGNORED. They are required for the Kiroween
# 2026 submission and must be committed to Git. Do not add .kiro/ here.

# --- Dependencies (generated, re-installable) ---
node_modules/
.pnp
.pnp.js

# --- Build output / generated bundles ---
dist/
web-dist/
build/
out/
*.tsbuildinfo

# --- Test / coverage output ---
coverage/
.vitest/

# --- Secrets and local environment (never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/

# NOTE: .vscode/ is intentionally NOT ignored project-wide so shared settings
# can be committed if we add them. Add specific files here later if needed.

# --- Clinical Cards local authoring/review artifacts (development-only) ---
# Regenerated by `npm run review-report` and the authoring tools. The shipped
# data in clinical-cards/src/data/ and the authoring templates stay tracked.
clinical-cards/review-output/
clinical-cards/authoring/backups/

# --- Caches ---
.cache/
.vite/
.eslintcache
